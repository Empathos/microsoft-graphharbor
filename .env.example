TENANT_ID=YOUR_TENANT_ID
CLIENT_ID=YOUR_CLIENT_ID
CHAT_ID=YOUR_CHAT_ID
TOKEN_FILE=path/to/graphharbor-token-store
STATE_FILE=path/to/graphharbor-state.json
POLL_INTERVAL_MS=5000
REPLY_PREFIX=GraphHarbor received
INTERPRETER_COMMAND=node scripts/openclaw-interpreter.mjs
GRAPHHARBOR_REPO_DIR=path/to/microsoft-graphharbor
OPENCLAW_BIN=openclaw
OPENCLAW_SESSION_KEY=agent:main:graphharbor-teams
OPENCLAW_TIMEOUT_SECONDS=180
OPENCLAW_THINKING=low
GRAPHHARBOR_LOG_DIR=path/to/graphharbor-logs
GRAPHHARBOR_LOCK_FILE=path/to/graphharbor-poll.lock
GRAPHHARBOR_POLL_TIMEOUT_SECONDS=45

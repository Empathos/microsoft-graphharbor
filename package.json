{
  "name": "microsoft-graphharbor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Endpoint-free agent bridge for Microsoft Teams over Microsoft Graph.",
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc",
    "start": "node dist/index.js",
    "prime": "node dist/index.js prime",
    "read-smoke": "node dist/index.js read-smoke",
    "cron-poll": "bash scripts/graphharbor-poll-cron.sh",
    "poll-once": "node dist/index.js poll-once",
    "send-message": "node dist/index.js send-message"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
